# شغّل البرنامج:  nyx run examples/arabic_demo.nx
# ─────────────────────────────────────────────────────────────────────────────

# ── المتغيرات ─────────────────────────────────────────────────────────────────
اجعل الاسم = "نيكسل"
اجعل الإصدار = 1
اجعل جاهز = صحيح

قل("مرحباً من", الاسم)
قل("")

# ── الشروط ────────────────────────────────────────────────────────────────────
اجعل الدرجة = 85

عندما الدرجة >= 90:
    قل("تقدير: ممتاز")
وإلا عندما الدرجة >= 75:
    قل("تقدير: جيد جداً")
وإلا عندما الدرجة >= 60:
    قل("تقدير: جيد")
وإلا:
    قل("تقدير: راسب")

قل("")

# ── الحلقات ───────────────────────────────────────────────────────────────────
قل("العد من 1 إلى 5:")
كرر i من 1 إلى 5:
    قل(" ", i)

قل("")

# ── القوائم والتصفية ───────────────────────────────────────────────────────────
اجعل الدرجات = [45, 82, 91, 67, 55, 78, 95, 60]

اجعل الناجحون = الدرجات حيث item >= 60
اجعل الراسبون = الدرجات حيث item < 60

قل("الدرجات:", الدرجات)
قل("الناجحون:", الناجحون)
قل("الراسبون:", الراسبون)
قل("المتوسط:", تقريب(متوسط(الدرجات), 1))
قل("")

# ── إضافة إلى قائمة ───────────────────────────────────────────────────────────
اجعل الطلاب = []
أضف "أحمد" إلى الطلاب
أضف "فاطمة" إلى الطلاب
أضف "محمد" إلى الطلاب
أضف "زينب" إلى الطلاب

قل("الطلاب:", الطلاب)
قل("عدد الطلاب:", طول(الطلاب))
قل("")

# ── الدوال ────────────────────────────────────────────────────────────────────
دالة تحية(الاسم, مرات = 1):
    كرر مرات:
        قل("مرحباً،", الاسم + "!")

تحية("أحمد")
تحية("فاطمة", 2)
قل("")

# ── الكائنات ──────────────────────────────────────────────────────────────────
اجعل المستخدمون = [
    {"الاسم": "أحمد",   "العمر": 25, "نشط": صحيح},
    {"الاسم": "فاطمة",  "العمر": 16, "نشط": صحيح},
    {"الاسم": "محمد",   "العمر": 30, "نشط": خطأ},
    {"الاسم": "زينب",   "العمر": 22, "نشط": صحيح}
]

اجعل النشطون = المستخدمون حيث item.نشط == صحيح
اجعل الكبار = المستخدمون حيث item.العمر >= 18 و item.نشط == صحيح

قل("المستخدمون النشطون:", طول(النشطون))
قل("الكبار النشطون:")
لكل كل مستخدم في الكبار:
    قل(" -", مستخدم.الاسم, "(العمر:", إلى_نص(مستخدم.العمر) + ")")

قل("")

# ── معالجة الأخطاء ────────────────────────────────────────────────────────────
دالة قسمة_آمنة(أ, ب):
    حاول:
        أرجع أ / ب
    اصطد ع:
        قل("لا يمكن القسمة على صفر!")
        أرجع 0

قل("10 / 2 =", قسمة_آمنة(10, 2))
قل("10 / 0 =", قسمة_آمنة(10, 0))
قل("")

قل("انتهى البرنامج بنجاح!")
