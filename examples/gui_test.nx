let count = 0

fn on_add():
    count = count + 1
    display.text = "Count: " + to_str(count)

fn on_reset():
    count = 0
    display.text = "Count: 0"

create window("Counter") size(300, 200):
    display = label("Count: 0")       place(20, 20)
    btn("Add")    on_click(on_add)    place(20, 60)
    btn("Reset") color("red") on_click(on_reset) place(120, 60)