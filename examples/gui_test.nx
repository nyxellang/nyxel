let count = 0

bring gui

let win = gui.window("Counter", 300, 200)

fn on_add():
    count = count + 1
    display.text = "Count: " + to_str(count)

fn on_reset():
    count = 0
    display.text = "Count: 0"

display = win.add(gui.label("Count: 0"))
win.add(gui.btn("Add").on_click(on_add))
win.add(gui.btn("Reset").color("red").on_click(on_reset))
win.run()
